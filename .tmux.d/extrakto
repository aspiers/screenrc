set -g @extrakto_open_tool 'tmux-action'
# Prefer Oh My Zsh's clipcopy detection over extrakto's built-in clipboard heuristic.
set -g @extrakto_clip_tool '$HOME/bin/tmux-clipcopy'

# Found this command for triggering extrakto via:
#
#   tmux list-keys G extrakto
bind -n C-M-o run-shell "\"$HOME/.tmux/plugins/extrakto/scripts/open.sh\" \"#{pane_id}\""
