# N.B. set -g sets global session options; these can still be
# overridden per session.
#
# Also be aware that creating a new session via 'tmux' will not
# re-read any config files if the server is already running; it will
# just connect to the running server.

# Allow cx / set_title screen to work
setw -g allow-rename on

# set -g status-left "#{session_name}»"
# set -g status-right "«#{s/-.*//:#{host_short}}"
set -g status-left "#[reverse]#{session_name} "
set -g status-right "#[reverse] #{s/-.*//:#{host_short}}"

set -g status-left-length 0

set -g status-left-style  fg=default
set -g status-right-style fg=default
# set -g status-left-style  fg=red
# set -g status-right-style fg=red

set -g status-style      bg=green


# Show the pane title (#T) rather than the static tmux window name (#W)
# so pi-status can display live agent activity in the tmux window list.
# Keep entries compact; pi-status titles can be long.
set -g window-status-format         " #I:#{=24:pane_title} "
set -g window-status-current-format " #I:#{=32:pane_title} "
set -g window-status-separator      ""

set -g window-status-current-style  bg=blue,bold
set -g window-status-last-style     fg=white,bold
set -g window-status-style          fg=black

set -g window-status-activity-style bg=blue,fg=black
set -g window-status-bell-style     bg=red,fg=black

if-shell 'hostname -s | grep -q "^vps"' {
  set -g status-style                 bg=red
  set -g window-status-current-style  bg=blue,bold
  set -g window-status-last-style     fg=white,bold
  set -g window-status-activity-style bg=brightyellow,fg=black
  set -g window-status-bell-style     bg=brightgreen,fg=black
}

