#!/bin/bash
#
# Toggle terminal between light and dark themes using OSC 10/11.
#
# Queries the current background colour via OSC 11, then switches:
#   dark  bg → light theme (white bg, black fg)
#   light bg → dark  theme (black bg, white fg)
#
# With any argument, instead emits OSC 110/111 to reset fg/bg to
# the terminal's configured defaults — useful after a prior toggle
# has left a runtime override masking profile/theme changes made
# by set-colour-theme.
#
# Works in terminals that support OSC 10/11 (xterm, foot, kitty,
# alacritty, etc.).  Inside tmux, pass-through is needed — tmux 3.3+
# with allow-passthrough handles this automatically.

set -e

# Colour definitions (4-digit hex per component, as OSC expects)
LIGHT_BG="rgb:ffff/ffff/ffff"
LIGHT_FG="rgb:0000/0000/0000"
DARK_BG="rgb:0000/0000/0000"
DARK_FG="rgb:ffff/ffff/ffff"

query_bg_colour() {
    # Send OSC 11 query and read the terminal's response.
    # The terminal replies with: \e]11;rgb:RRRR/GGGG/BBBB\e\\
    # We need raw mode so the response isn't echoed or line-buffered.
    local response

    # Avoid `stty -g` / restore — uutils coreutils stty can't round-trip
    # its own -g output.  Instead, manually toggle the settings we need
    # and restore them explicitly.
    stty -icanon -echo min 0 time 10 < /dev/tty   # raw-ish, 1s timeout

    # Query background colour
    printf '\e]11;?\e\\' > /dev/tty

    # Read response — may be terminated by \e\\ (ST) or \a (BEL)
    response=""
    while IFS= read -r -d '' -n 1 char <&3; do
        response+="$char"
        # Stop at ST (\e\\) or BEL (\a)
        if [[ "$char" == $'\a' ]]; then
            break
        fi
        if [[ "$response" == *$'\e\\' ]]; then
            break
        fi
    done 3< /dev/tty

    stty icanon echo < /dev/tty

    # Extract the rgb:RRRR/GGGG/BBBB portion
    if [[ "$response" =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]]; then
        echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
    else
        return 1
    fi
}

set_theme() {
    local bg="$1" fg="$2"
    # OSC 11 = background, OSC 10 = foreground
    printf '\e]11;%s\e\\\e]10;%s\e\\' "$bg" "$fg"
}

reset_theme() {
    # OSC 110 = reset foreground, OSC 111 = reset background.
    # Clears any runtime OSC 10/11 override so terminal falls back
    # to its configured profile colours.
    printf '\e]110\e\\\e]111\e\\' > /dev/tty
}

is_light_bg() {
    # Determine whether the background is "light" by checking
    # if all RGB components are above the midpoint (0x8000).
    local components="$1"
    local r g b
    IFS='/' read -r r g b <<< "$components"

    # Terminals may return 1-, 2-, or 4-digit hex per component.
    # Shorter values represent the most-significant digits, so
    # right-pad with zeros to normalise to 4 digits (e.g. "ff" → "ff00").
    r="${r}0000"; r="${r:0:4}"
    g="${g}0000"; g="${g:0:4}"
    b="${b}0000"; b="${b:0:4}"

    if (( 16#$r > 16#8000 && 16#$g > 16#8000 && 16#$b > 16#8000 )); then
        return 0  # light
    fi
    return 1  # dark
}

main() {
    if [[ $# -gt 0 ]]; then
        reset_theme
        exit 0
    fi

    local bg_rgb
    if ! bg_rgb=$(query_bg_colour); then
        echo "Failed to query terminal background colour." >&2
        echo "Your terminal may not support OSC 11." >&2
        exit 1
    fi

    if is_light_bg "$bg_rgb"; then
        set_theme "$DARK_BG" "$DARK_FG"
    else
        set_theme "$LIGHT_BG" "$LIGHT_FG"
    fi
}

main "$@"
